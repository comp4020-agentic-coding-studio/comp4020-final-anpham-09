node_modules/
dist/
*.log

# the local SQLite file. Production's lives on the Fly volume at /data; this
# one is a dev scratch database and must never be committed — it is state,
# not source, and it would ship into the image.
.data/

# editor and OS junk
.DS_Store
._*
Thumbs.db
Desktop.ini

# keep secrets out of the repo: your API key lives in an env var or an
# untracked file, never in a tracked one
.env
.env.*
.envrc
mise.local.toml
*.pem

# Claude Code's project directory is machine-local: settings in here can hold
# your course API key, and this repo goes public when you ship. Your tracked
# harness is CLAUDE.md (and any AGENTS.md), not this directory.
.claude/

# JetBrains project files: machine-local, and they record absolute paths from
# this checkout. This repo goes public.
.idea/

# Design source material from Figma. `assets/village-assets/` is kept: it is
# what scripts/build-images.sh reads to produce the WebP files in img/, and
# without it those cannot be regenerated. The rest is a 67MB pile of screen
# exports and a zip of the same — reference for building the UI, not input to
# it, and this repo goes public on a 256MB machine.
exports/
assets/village-screens*/
# Same reasoning for the ô ăn quan screens: 14MB of PNG and SVG that only a
# person reading them needs. Its README is the exception and is tracked by
# name below, because it records the family's house rules — dân 1, quan 10,
# no borrowing, no timer — which the engine implements and which exist
# nowhere else in writing.
assets/o-an-quan*/*
!assets/o-an-quan*/README.md
