node_modules/
dist/
*.log

# the local SQLite file. Production's lives on the Fly volume at /data; this
# one is a dev scratch database and must never be committed — it is state,
# not source, and it would ship into the image.
.data/

# editor and OS junk
.DS_Store
._*
Thumbs.db
Desktop.ini

# keep secrets out of the repo: your API key lives in an env var or an
# untracked file, never in a tracked one
.env
.env.*
.envrc
mise.local.toml
*.pem

# Claude Code's project directory is machine-local: settings in here can hold
# your course API key, and this repo goes public when you ship. Your tracked
# harness is CLAUDE.md (and any AGENTS.md), not this directory.
.claude/

# JetBrains project files: machine-local, and they record absolute paths from
# this checkout. This repo goes public.
.idea/
